+++ b/analysis/step5_evaluate.py
@@ -0,0 +1,28 @@
+"""Step 5: evaluate OOF predictions with cross-sectional IC + HAC correction."""
+
+import pandas as pd
+from ml4t.diagnostic.metrics import cross_sectional_ic_series, compute_ic_hac_stats
+
+oof = pd.read_parquet("analysis/oof_predictions.parquet")
+
+ic_series = cross_sectional_ic_series(
+    oof, oof,
+    pred_col="prediction", ret_col="fwd_ret_21",
+    date_col="timestamp", entity_col="symbol",
+    method="spearman",
+)
+
+print(f"IC series: {len(ic_series)} dates, "
+      f"{ic_series['ic'].isna().sum()} undefined (< min_obs or all-tied)")
+print(ic_series.head())
+print()
+
+stats = compute_ic_hac_stats(ic_series, ic_col="ic", label_horizon=21)
+
+print(f"n periods:        {stats['n_periods']}")
+print(f"mean IC:          {stats['mean_ic']:.4f}")
+print(f"naive SE:         {stats['naive_se']:.5f}")
+print(f"HAC SE:           {stats['hac_se']:.5f}")
+print(f"naive t-stat:     {stats['naive_t_stat']:.2f}")
+print(f"HAC t-stat:       {stats['t_stat']:.2f}   (effective_lags={stats['effective_lags']})")
+print(f"HAC p-value:      {stats['p_value']:.4g}")
